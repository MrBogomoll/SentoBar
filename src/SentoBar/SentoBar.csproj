<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <AssemblyName>SentoBar</AssemblyName>
    <RootNamespace>SentoBar</RootNamespace>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Title>SentoBar</Title>
    <Product>SentoBar</Product>
    <Company>SentoBar</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MrBogomoll/nabyscape</RepositoryUrl>
    <!-- WPF owns DPI awareness; WinForms is used only for Screen and NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <StartupObject>SentoBar.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="UI\Shared\Russian.*.json" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Lucene.Net.Analysis.Kuromoji" Version="4.8.0-beta00018" />
    <PackageReference Include="NTextCat" Version="0.3.65" />
    <Resource Include="Assets\island.ico" />
    <Resource Include="Assets\brand-avatar.png" />
    <EmbeddedResource Include="Assets\brand-mark.svg" LogicalName="SentoBar.BrandMark.svg" />
    <Resource Include="Assets\Fonts\Manrope-Medium.ttf" />
    <Resource Include="Assets\Fonts\Manrope-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Manrope-Bold.ttf" />
    <EmbeddedResource Include="..\..\docs\presets\default-preferences.json" LogicalName="SentoBar.DefaultPreferences.json" />
    <EmbeddedResource Include="..\..\tools\Uninstall-SentoBar.ps1" LogicalName="SentoBar.Uninstall.ps1" />
    <EmbeddedResource Include="..\..\docs\presets\default-layout.json" LogicalName="SentoBar.DefaultLayout.json" />
    <EmbeddedResource Include="..\..\tools\local_voice_server.py" LogicalName="SentoBar.LocalAsrServer" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="SentoBar.LICENSE" />
    <EmbeddedResource Include="..\..\licenses\NAudio-LICENSE.txt" LogicalName="SentoBar.NAudio-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\System.Speech-LICENSE.txt" LogicalName="SentoBar.System.Speech-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\LUCIDE-LICENSE.txt" LogicalName="SentoBar.LUCIDE-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\MANROPE-OFL.txt" LogicalName="SentoBar.MANROPE-OFL.txt" />
    <EmbeddedResource Include="..\..\licenses\DOTNET-LICENSE.txt" LogicalName="SentoBar.DOTNET-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\DOTNET-ThirdPartyNotices.txt" LogicalName="SentoBar.DOTNET-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\licenses\ROMAJI-ThirdPartyNotices.txt" LogicalName="SentoBar.ROMAJI-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\licenses\LYRICS-LANGUAGE-LICENSE.txt" LogicalName="SentoBar.LYRICS-LANGUAGE-LICENSE.txt" />
    <EmbeddedResource Include="Assets\lyrics-languages.profile.xml.gz" LogicalName="SentoBar.LyricsLanguages" />
  </ItemGroup>
</Project>
